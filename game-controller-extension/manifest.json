{
  "manifest_version": 3,
  "name": "NeuroReach Game Controller",
  "version": "0.2.1",
  "description": "Use NeuroReach camera and EEG controls with a game you choose on supported game websites.",
  "minimum_chrome_version": "125",
  "permissions": ["activeTab", "scripting", "debugger"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Connect NeuroReach controls"
  },
  "commands": {
    "stop-controls": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop NeuroReach game controls"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
