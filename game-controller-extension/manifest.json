{
  "manifest_version": 3,
  "name": "NeuroReach Game Controller",
  "version": "0.5.0",
  "description": "Use NeuroReach camera and EEG controls with a game you choose on supported game websites.",
  "minimum_chrome_version": "125",
  "homepage_url": "https://blizzard-labs.github.io/thalis-rehab-game/#library",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self'; frame-src http://localhost:* http://127.0.0.1:* https://blizzard-labs.github.io/thalis-rehab-game/; base-uri 'none'; form-action 'none'"
  },
  "permissions": ["activeTab", "scripting", "debugger", "sidePanel", "storage"],
  "side_panel": { "default_path": "sidebar.html" },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://blizzard-labs.github.io/thalis-rehab-game/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
    "default_popup": "popup.html",
    "default_title": "Connect NeuroReach controls"
  },
  "commands": {
    "stop-controls": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop NeuroReach game controls"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://blizzard-labs.github.io/thalis-rehab-game/*"
      ],
      "js": ["protocol.js", "bridge.js"],
      "run_at": "document_start"
    }
  ]
}
