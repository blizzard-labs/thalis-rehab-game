{
  "name": "neuroreach-patient-web",
  "version": "0.0.1",
  "private": true,
  "description": "NeuroReach patient web client — V2-1 Garden Grow prototype",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "predev": "node scripts/prepare-camera.mjs",
    "prebuild": "node scripts/prepare-camera.mjs",
    "test:e2e": "playwright test",
    "postbuild": "node scripts/build-offline.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "jsdom": "^24.0.0",
    "typescript": "^5.5.0",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.17",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "qrcode": "1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.169.0"
  }
}
