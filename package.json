{
  "name": "neuroreach-localhost",
  "private": true,
  "scripts": {
    "package:extension": "node patient-web/scripts/package-controller.mjs",
    "test:extension": "node --test scripts/controller-security.test.mjs && python3 packaging/verify-extension.py",
    "start": "node scripts/start-local.mjs",
    "build": "npm --prefix patient-web run build",
    "build:website": "node scripts/build-website.mjs",
    "test": "node --test scripts/companion.test.mjs scripts/website.test.mjs scripts/controller-security.test.mjs && npm --prefix patient-web test",
    "companion": "conda run --no-capture-output -n eeg python signal-engine/local_companion.py"
  }
}
